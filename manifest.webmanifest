{
  "id": "./",
  "name": "Love Login",
  "short_name": "Love Login",
  "description": "A private space to share messages, stories, and little moments.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f0c11",
  "theme_color": "#8e2b4b",
  "categories": ["lifestyle", "social"],
  "icons": [
    {
      "src": "./icons/love-login.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/love-login-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/love-login-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
