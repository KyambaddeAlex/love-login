rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "cRsPXPZrpxQAwAvA7D6Jd9uU9ca2";
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == (
          request.auth.uid == "cRsPXPZrpxQAwAvA7D6Jd9uU9ca2" ? "admin" : "girlfriend"
        );
      allow update: if request.auth != null && (isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["username", "age", "bio"])
      )
      );
      allow delete: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );
    }

    // Each account can manage only its own registered push devices.
    match /pushTokens/{userId}/devices/{deviceId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(["token", "updatedAt"]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 0 &&
        request.resource.data.token.size() <= 4096 &&
        request.resource.data.updatedAt == request.time;
    }

    // Admins manage tasks; assignees can submit one immutable completion.
    match /tasks/{taskId} {
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.assignedTo
      );
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        (isAdmin() &&
          request.resource.data.get("completionNote", null) == resource.data.get("completionNote", null) &&
          request.resource.data.get("completedAt", null) == resource.data.get("completedAt", null)
        ) || (
          request.auth.uid == resource.data.assignedTo &&
          resource.data.status != "done" &&
          resource.data.get("completionNote", "") == "" &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "completionNote", "completedAt"]) &&
          request.resource.data.status == "done" &&
          request.resource.data.completionNote is string &&
          request.resource.data.completionNote.size() > 0 &&
          request.resource.data.completionNote.size() <= 2000 &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.completedAt == request.time
        )
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Messages collection: both parties can read/write.
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
      allow create: if request.auth != null && (
        request.resource.data.senderId == request.auth.uid && (
          isAdmin() || request.resource.data.receiverId == "cRsPXPZrpxQAwAvA7D6Jd9uU9ca2"
        )
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.senderId
      );
      allow delete: if request.auth != null && isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          "type", "taskId", "taskTitle", "completionNote", "assignedTo", "read", "createdAt"
        ]) &&
        request.resource.data.type == "task_completed" &&
        request.resource.data.assignedTo == request.auth.uid &&
        request.resource.data.completionNote is string &&
        request.resource.data.completionNote.size() > 0 &&
        request.resource.data.completionNote.size() <= 2000 &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)) &&
        get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.assignedTo == request.auth.uid &&
        get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.status != "done" &&
        getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.status == "done" &&
        request.resource.data.taskTitle == get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.title &&
        request.resource.data.completionNote == getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.completionNote;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]) &&
        request.resource.data.read == true &&
        request.resource.data.readAt == request.time;
      allow delete: if isAdmin();
    }

    // Girlfriends can submit their own stories; only the admin can read them.
    match /stories/{storyId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        request.auth.uid != "cRsPXPZrpxQAwAvA7D6Jd9uU9ca2" &&
        request.resource.data.keys().hasOnly(["content", "authorId", "authorName", "createdAt"]) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000 &&
        request.resource.data.authorName is string &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
