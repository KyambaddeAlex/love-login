rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "kyambaddealex55@gmail.com";
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );
      allow delete: if request.auth != null && (
        isAdmin() || request.auth.uid == userId
      );
    }

    // Tasks collection: write/delete strictly admin.
    match /tasks/{taskId} {
      allow read: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.assignedTo
      );
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.assignedTo
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Messages collection: both parties can read/write.
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
      allow create: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == request.data.senderId ||
        request.auth.uid == request.data.receiverId
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.senderId
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Stories collection: read for all authenticated; write for author/admin.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.authorId
      );
      allow delete: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.authorId
      );
    }
  }
}
